# Uncanny Atlas — environment configuration. Copy to `.env` and adjust.
# Every value below is OPTIONAL; the defaults shown match src/isthisai/config.py.
# Nothing here is a secret — there are no API keys (Reddit data comes from the
# public PullPush / Arctic Shift archives, and the models run locally via Ollama).

# ---- Database --------------------------------------------------------------
# Path to the SQLite database (shared by the Python pipeline and the web app).
ISTHISAI_DB_PATH=data/isthisai.db

# ---- Web app / deployment --------------------------------------------------
# Port for the built SvelteKit (adapter-node) server: `node web/build`.
PORT=3000
# Read-only deployment: opens the DB read-only, blocks POSTs to /curate, hides
# the Curate nav, and enables in-process load memoization. Leave unset locally
# so curation works. Set to 1/true on the public site.
ISTHISAI_READONLY=

# ---- Models (pipeline only; not needed to serve the site) ------------------
# Extraction LLM — any Ollama chat model. Swapping it is a pure env change.
ISTHISAI_OLLAMA_URL=http://localhost:11434
ISTHISAI_OLLAMA_MODEL=gemma3:4b
ISTHISAI_OLLAMA_NUM_CTX=4096
ISTHISAI_OLLAMA_TIMEOUT=600
# Duration string ("10m") or seconds (-1 = keep model resident forever).
ISTHISAI_OLLAMA_KEEP_ALIVE=10m
ISTHISAI_EXTRACTION_SAMPLE_SIZE=2500
ISTHISAI_EXTRACTION_BATCH_SIZE=5
# Embedding model. NOTE: changing this changes the vector dimension, so you must
# re-embed from scratch (drop comment_embeddings + indicator_embeddings) — you
# cannot mix dimensions. See the README "Models / reproduce" section.
ISTHISAI_EMBED_MODEL=nomic-embed-text
ISTHISAI_EMBED_BATCH_SIZE=64
ISTHISAI_EMBED_THRESHOLD=0.73
ISTHISAI_GROUNDING_THRESHOLD=0.45

# ---- Reddit collection (PullPush) ------------------------------------------
ISTHISAI_PULLPUSH_URL=https://api.pullpush.io
ISTHISAI_SUBREDDIT=isthisAI
ISTHISAI_PAGE_SIZE=100
ISTHISAI_DELAY=2.0
ISTHISAI_MAX_RETRIES=5
ISTHISAI_INITIAL_RETRY_DELAY=2.0
ISTHISAI_MAX_RETRY_DELAY=60.0
ISTHISAI_REQUEST_TIMEOUT=30.0
